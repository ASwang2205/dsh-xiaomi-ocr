{
  "name": "dsh-xiaomi-ocr",
  "version": "0.1.0",
  "description": "Local OCR for DeepSeek Harness: Xiaomi-OCR-0 (0.8B) runs on this machine through a managed Python service. Five tools (ocr_image / ocr_pdf / ocr_kie / ocr_vqa / ocr_status), Markdown + OTSL/HTML tables + LaTeX formulas, result caching, PDF rasterisation, and a dedicated 本地 OCR settings page. No image ever leaves the device.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "runtime/",
    "docs/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ocr",
    "local-ocr",
    "xiaomi-ocr",
    "qwen3-vl",
    "offline",
    "pdf",
    "markdown"
  ],
  "license": "MIT",
  "author": "ASwang2205",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASwang2205/dsh-xiaomi-ocr.git"
  },
  "homepage": "https://github.com/ASwang2205/dsh-xiaomi-ocr#readme",
  "bugs": {
    "url": "https://github.com/ASwang2205/dsh-xiaomi-ocr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "react"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.4.0-0"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
